{
  "manifest_version": 3,
  "name": "Kelex Download Manager",
  "version": "2.0.0",
  "description": "Terminal-first download manager integration for Chrome, Firefox, Edge, and Brave.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kelex Download Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*",
    "*://*/*"
  ]
}
